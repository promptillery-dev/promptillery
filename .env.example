# Copy to .env and fill in the keys you need. The CLI auto-loads .env.
#
# Only the teacher provider you actually configure is required. The example
# configs under examples/ route their teacher through OpenRouter.

# Teacher via OpenRouter (used by every config in examples/)
OPENROUTER_API_KEY=sk-or-v1-...

# Alternative teacher providers, if you point a config at them instead
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...

# Optional: only needed to push trained students to the Hugging Face Hub
# HF_TOKEN=hf_...
